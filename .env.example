# Connector URL from the assistant admin (MCP -> Local connector). Keep it secret.
MCP_ENDPOINT=
# Starting directory for commands; not a sandbox. Defaults to your home directory.
# BASH_WORKDIR=~/assistant-shell
# Extra environment variables commands may see (comma-separated). The assistant can read them.
# BASH_PASS_ENV=GITHUB_TOKEN
# Where every command is logged (JSON lines). Defaults to audit.jsonl next to bash_server.py.
# BASH_AUDIT_LOG=~/mcp-bash-audit.jsonl
# Tool name; give each machine connected to the same assistant its own. Defaults to bash.
# BASH_TOOL_NAME=web01_bash
# Assistant Core surfaces the tool is offered on (comma-separated): app, widget, api, voice, messaging.
# Defaults to app. Every surface you add lets the people chatting there run commands.
# BASH_SURFACES=app
